# ==================== Flask ====================
# کلید امنیتی برای امضای session
# برای ساخت: python -c "import secrets; print(secrets.token_hex(32))"
# در production حتماً عوضش کن و backup بگیر
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ==================== Registration ====================
# فعال‌سازی ثبت‌نام کاربر جدید (پیش‌فرض: خاموش)
# ALLOW_REGISTER=1

# ==================== Proxy (پشت nginx) ====================
# اگه پشت nginx هستی، این‌ها رو فعال کن
# BEHIND_PROXY=1
# COOKIE_SECURE=1

# ==================== CORS ====================
# دامنه‌های مجاز برای درخواست‌های تغییردهنده (با کاما جدا)
# ALLOWED_ORIGINS=https://example.com,https://www.example.com